# Polygon.io API Configuration
POLYGON_API_KEY=your_polygon_api_key_here
POLYGON_BASE_URL=https://api.polygon.io
# Set to true for Stock Starter plan (15-min delayed), false for real-time plans
POLYGON_USE_DELAYED_DATA=true

# WebSocket Configuration
POLYGON_ENABLE_WEBSOCKET=true
POLYGON_WEBSOCKET_RECONNECT_INTERVAL=5
POLYGON_WEBSOCKET_HEARTBEAT_INTERVAL=30
POLYGON_WEBSOCKET_MAX_SUBSCRIPTIONS=100
POLYGON_WEBSOCKET_BUFFER_SIZE=1000

# WebSocket Subscription Defaults (LightSpeed Certification Test Symbols)
# These symbols exhibit specific behaviors in LightSpeed certification environment:
# GOOGL: Immediate fill | AMZN: Partial fill | TSLA: No fill | MSFT: Rejection
# CHWY/F/GE: Multiple partials | ORCL: Cancel test | BAC: Replace test
POLYGON_DEFAULT_SUBSCRIPTIONS=GOOGL,AMZN,TSLA,MSFT,CHWY
POLYGON_AUTO_SUBSCRIBE_MOVERS=true

# LightSpeed Trading API Configuration
LIGHTSPEED_API_KEY=your_lightspeed_api_key_here
LIGHTSPEED_CONNECTION_URL=wss://onboarding.connecttrade.com:28052
LIGHTSPEED_CLIENT_ID=LIGHTSPEED
LIGHTSPEED_ACCOUNT_ID=your_lightspeed_account_id_here
LIGHTSPEED_SANDBOX=true

# Trading Mode Configuration
TRADING_MODE=PAPER           # PAPER, LIVE, SIMULATION

# Paper Trading Configuration
PAPER_INITIAL_CASH=100000.0
PAPER_COMMISSION_PER_SHARE=0.005
PAPER_ENABLE_COMMISSION=true

# Rules Engine Configuration (New - Zero Hard-coded Values)
RULES_ENGINE_ENABLED=false
# Required when enabled:
# RULES_ENGINE_EVALUATION_INTERVAL_MS=1000
# RULES_ENGINE_MAX_DECISION_TIME_MS=5
# RULES_ENGINE_WARNING_THRESHOLD_MS=3

# Rules Engine Behavior
RULES_TRACK_PERFORMANCE_METRICS=true
RULES_LOG_ALL_DECISIONS=false
RULES_REQUIRE_USER_CONFIRMATION=true
# RULES_DECISION_HISTORY_DAYS=30

# Price Fallback Strategy (when market data unavailable)
RULES_FALLBACK_PRICE_SOURCE=REFUSE  # Options: LAST_KNOWN, MARKET_CLOSE, USER_150.00, REFUSE
RULES_DEFAULT_WATCHLIST_SYMBOLS=GOOGL,AMZN,TSLA,MSFT

# Position Management (Optional)
# RULES_ALLOW_NEW_POSITIONS=true  
# RULES_MAX_CONCURRENT_RULES=10

# Application Configuration
DATABASE_URL=sqlite:./trading.db
MAX_MEMORY_MB=1024
BIND_ADDRESS=0.0.0.0:8080
METRICS_ADDRESS=0.0.0.0:9090
RUST_LOG=info

# Module Control
ENABLE_LIGHTSPEED=true
ENABLE_POLYGON=true
